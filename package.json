{
  "name": "neurosync-cyberpunk-ai-aggregator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "cd server && npm run dev",
    "dev:all": "npm run dev:server & sleep 2 && npm run dev",
    "build": "vite build",
    "build:server": "cd server && npm run build",
    "build:all": "npm run build:server && npm run build",
    "start:server": "cd server && npm run start",
    "start:prod": "npm run start:server & npm run preview",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts && cd server && npm run test",
    "test:watch": "vitest --config vitest.config.ts",
    "test:server": "cd server && npm run test"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.4",
    "jsdom": "^29.0.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.4"
  }
}
